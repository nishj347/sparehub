# ==============================================================================
# SpareHub - Render Web Service Environment Configuration Template (.env.render.example)
#
# Reference template for backend variables when running on Render's free tier.
# When deploying via render.yaml (Blueprint), most of these are configured
# automatically. Variables marked `sync: false` in render.yaml must be entered
# in the Render service Environment settings dashboard.
#
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Network & Server Port (managed by render.yaml)
# Render routes external traffic to the port your service listens on.
PORT=8000

# Application Environment Mode (managed by render.yaml)
# production activates strict security validations in backend/app/core/config.py
APP_ENV=production

# Application Timezone (managed by render.yaml)
# Must be a valid IANA timezone (e.g., Asia/Kolkata, UTC)
APP_TIMEZONE=Asia/Kolkata

# Uvicorn Worker Concurrency (managed by render.yaml)
# Render free tier provides 0.5 CPU / 512MB RAM; 1 worker prevents OOM kills.
WEB_CONCURRENCY=1

# Reverse Proxy Trust Count (managed by render.yaml)
# Render runs behind Cloudflare and internal load balancers (2 proxy hops).
TRUSTED_PROXY_COUNT=2

# Application Cryptographic Secret Key (managed by render.yaml: generateValue: true)
# If entering manually: must be at least 32 cryptographically secure random characters.
# Generate locally via: ./scripts/deploy/gen-secret.sh or .\scripts\deploy\gen-secret.ps1
SECRET_KEY=replace-with-32-plus-char-random-key-or-use-render-generateValue

# PostgreSQL Database Connection String (sync: false in render.yaml - enter in dashboard)
# Neon provides a URL starting with postgresql://. SpareHub uses psycopg v3 and requires
# postgresql+psycopg:// with sslmode=require. Convert via ./scripts/deploy/neon-url.sh
# Example: postgresql+psycopg://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://username:password@ep-placeholder.region.aws.neon.tech/neondb?sslmode=require

# Allowed CORS Origins (sync: false in render.yaml - enter in dashboard)
# Comma-separated list of origins permitted to make cross-origin requests.
# In production, every origin MUST use https:// (no wildcards permitted).
# Set to your Vercel frontend URL once deployed (e.g. https://your-project.vercel.app).
CORS_ORIGINS=https://your-frontend-domain.vercel.app

# Host Header Validation (LEAVE UNSET on Render)
# By default, leave ALLOWED_HOSTS commented out / unset.
# Setting ALLOWED_HOSTS on Render can cause 400 "Invalid Host" errors because Render
# and Vercel proxy headers route requests through internal service hostnames.
# ALLOWED_HOSTS=

# Ephemeral File Storage (Default: uploads)
# On Render free tier, the local filesystem is ephemeral and reset upon restarts/redeploys.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Seed Password Guard (STRICTLY FORBIDDEN IN PRODUCTION)
# SEED_DEFAULT_PASSWORD must NOT be set in production. The backend validator will abort if set.
# SEED_DEFAULT_PASSWORD=
