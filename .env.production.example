# ==============================================================================
# SpareHub - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.production and supply production secrets before deployment:
#   cp .env.production.example .env.production
#
# IMPORTANT:
# - Never commit .env.production to version control (already in .gitignore).
# - Do NOT load or configure SEED_DEFAULT_PASSWORD in production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=sparehub_admin
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_AT_LEAST_24_CHARS
POSTGRES_DB=sparehub_prod

# SQLAlchemy connection string connecting to the 'db' container
# Format: postgresql+psycopg://<user>:<password>@db:5432/<db_name>
DATABASE_URL=postgresql+psycopg://sparehub_admin:CHANGE_THIS_TO_STRONG_PASSWORD_AT_LEAST_24_CHARS@db:5432/sparehub_prod

# ------------------------------------------------------------------------------
# 2. Application Core & Security
# ------------------------------------------------------------------------------
APP_ENV=production

# Generate a cryptographically strong 32+ character random secret using:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Place the generated output below:
SECRET_KEY=CHANGE_THIS_TO_AT_LEAST_32_CHAR_RANDOM_KEY_DO_NOT_USE_DEFAULT

# Explicit list of permitted CORS origins (comma-separated, https:// required in production)
# Example: https://spareparts.company.com,https://inventory.company.com
CORS_ORIGINS=https://spareparts.company.com

# Permitted Host header names (comma-separated) for Starlette TrustedHostMiddleware
# If left empty, host filtering middleware is disabled.
ALLOWED_HOSTS=spareparts.company.com,web,backend,localhost

# Number of reverse proxies in front of FastAPI (nginx = 1; if behind cloud load balancer + nginx = 2)
TRUSTED_PROXY_COUNT=1

# Application Timezone (must be a valid IANA timezone name)
APP_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 3. File Uploads & Storage
# ------------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=5

# ------------------------------------------------------------------------------
# 4. Server Concurrency & Web Port
# ------------------------------------------------------------------------------
# Number of uvicorn worker processes (typically 2-4 per CPU core)
WEB_CONCURRENCY=2

# Host port mapped to the Nginx reverse proxy
WEB_PORT=8080

# ------------------------------------------------------------------------------
# 5. Login Throttling & Brute-Force Protection
# ------------------------------------------------------------------------------
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_IP_RATE_PER_MINUTE=20

# ------------------------------------------------------------------------------
# 6. Development / Local Testing Overrides (Optional)
# ------------------------------------------------------------------------------
# Set to true ONLY if conducting local HTTP tests in production mode without TLS:
# ALLOW_INSECURE_CORS=false

